{
    "name": "nwo/signal-spectrum",
    "description": "Multi-Agent RF Signal Analysis & Apocalypse Detection Network",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "NWO Capital",
            "email": "dev@nwo.capital"
        }
    ],
    "require": {
        "php": ">=8.0",
        "ext-pdo": "*",
        "ext-redis": "*",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "sc0vu/web3-php": "^0.2.0",
        "predis/predis": "^2.0",
        "monolog/monolog": "^3.0",
        "vlucas/phpdotenv": "^5.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^1.10",
        "squizlabs/php_codesniffer": "^3.7",
        "phpunit/php-code-coverage": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "NWOSignalSpectrum\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NWOSignalSpectrum\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse src --level=8",
        "style": "phpcs --standard=PSR12 src/",
        "style-fix": "phpcbf --standard=PSR12 src/",
        "migrate": "php scripts/migrate.php",
        "seed": "php scripts/seed.php",
        "check": [
            "@style",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
